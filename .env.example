# ⚠️ IMPORTANT: Copy this file to .env and fill in YOUR values
# ⚠️ NEVER commit .env to GitHub - it contains secrets!

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-super-secure-password-here-min-20-chars
DB_NAME=cool_coffee

# Security Keys (MUST change before production!)
SECRET_KEY=your-generated-secret-key-here-min-32-chars
ADMIN_PASSWORD=your-admin-password-here-min-16-chars

# Debug Mode (MUST be False in production!)
DEBUG=False

# --- HOW TO GENERATE SECURE KEYS ---
# Run this in Python:
# import secrets
# print(secrets.token_hex(32))  # For SECRET_KEY
# 
# Then copy the output and paste into the variables above

